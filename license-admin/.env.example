# PharmaDesk Licensing — Next.js Admin Dashboard
# Copy this file to .env.local and fill in your real values.

MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/pharmadesk_licensing?retryWrites=true&w=majority"
JWT_SECRET="<generate-a-strong-random-secret-here>"
ADMIN_USERNAME="admin@pharmadesk.pk"
ADMIN_PASSWORD="<your-strong-admin-password>"
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<your-ed25519-private-key-base64>\n-----END PRIVATE KEY-----"
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<your-ed25519-public-key-base64>\n-----END PUBLIC KEY-----"
