# ═══════════════════════════════════════════════════════════════
# PharmaDesk — Master .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Dependencies ──
node_modules/

# ── Build & Distribution Artifacts ──
dist/
dist-ssr/
dist-renderer/
build/
out/
*.exe
*.zip
*.blockmap
*.msi
*.dmg
*.AppImage
*.snap
latest.yml

# ── Environment & Secrets ──
.env
.env.*
!.env.example
!**/.env.example
*.local
*.pem
*.key
*.p12
*.pfx

# ── Database Files ──
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal

# ── Next.js ──
.next/
next-env.d.ts

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor & IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ── Vercel ──
.vercel/

# ── TypeScript ──
*.tsbuildinfo

# ── OS Generated ──
desktop.ini
ehthumbs.db

# ── Licensing Server Local Data ──
licensing-server/data/licensing_db.json
